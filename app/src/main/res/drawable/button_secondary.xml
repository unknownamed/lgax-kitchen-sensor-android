<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/soft" /><corners android:radius="28dp" /><stroke android:width="1dp" android:color="@color/line" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/accent_soft" /><corners android:radius="28dp" /><stroke android:width="1dp" android:color="@color/accent" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/surface" /><corners android:radius="28dp" /><stroke android:width="2dp" android:color="@color/focus" /></shape></item>
    <item><shape><solid android:color="@color/surface" /><corners android:radius="28dp" /><stroke android:width="1dp" android:color="@color/accent" /></shape></item>
</selector>
