<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DishDry.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/page</item>
    </style>
    <style name="Theme.DishDry" parent="Theme.DishDry.Base" />
    <style name="SectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="SensorValue">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">15sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/secondary_button_text</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/card</item>
    </style>
    <style name="StatusBadge">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/badge</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
    <style name="SensorTile">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/sensor_tile</item>
    </style>
</resources>
